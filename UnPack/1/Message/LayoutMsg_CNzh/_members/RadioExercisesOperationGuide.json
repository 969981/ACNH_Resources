    },
    {
      "index": 58,
      "label": "0102",
      "text": "向上推，伸展背部肌肉。"
    },
    {
      "index": 59,
      "label": "0103",
      "text": "转动，大幅度转动双臂。"
    },
    {
      "index": 60,
      "label": "0104",
      "text": "将向左右推动，向侧边弯曲身体。"
    },
    {
      "index": 61,
      "label": "0105",
      "text": "用小幅度地、大幅度地，扭动身体。"
    },
    {
      "index": 62,
      "label": "0106",
      "text": "将向下推动，扩展胸肌。"
    },
    {
      "index": 63,
      "label": "0107",
      "text": "转动，大幅度地转动上半身。"
    },
    {
      "index": 64,
      "label": "0108",
      "text": "按小幅度地、按张开手脚，进行双脚跳。"
    },
    {
      "index": 65,
      "label": "0111",
      "text": "好，今天也精神饱满地做体操吧！"
    },
    {
      "index": 66,
      "label": "0112",
      "text": "好，广播体操现在开始——！"
    },
    {
      "index": 67,
      "label": "0113",
      "text": "好，精神饱满地运动吧！"
    },
    {
      "index": 68,
      "label": "0202",
      "text": "高举双手，伸展背部肌肉。"
    },
    {
      "index": 69,
      "label": "0203",
      "text": "前后大幅度地转动双臂。"
    },
    {
      "index": 70,
      "label": "0204",
      "text": "身体向左右侧弯，伸展侧身。"
    },
    {
      "index": 71,
      "label": "0205",
      "text": "配合节奏，左右扭转身体。"
    },
    {
      "index": 72,
      "label": "0206",
      "text": "身体向前弯，然后再扩展胸肌。"
    },
    {
      "index": 73,
      "label": "0207",
      "text": "上半身大幅度地转动画圆。"
    },
    {
      "index": 74,
      "label": "0208",
      "text": "配合节奏跳跃，进行双脚跳。"
    },
    {
      "index": 75,
      "label": "0211",
      "text": "好，今天也精神饱满地做体操吧！"
    },
    {
      "index": 76,
      "label": "0212",
      "text": "好，广播体操现在开始——！"
    },
    {
      "index": 77,
      "label": "0213",
      "text": "好，精神饱满地运动吧！"
    },
    {
      "index": 78,
      "label": "0302",
      "text": "将向上推动，伸展背部肌肉。"
    },
    {
      "index": 79,
      "label": "0303",
      "text": "转动，大幅度地转动双臂。"
    },
    {
      "index": 80,
      "label": "0304",
      "text": "将向左右推动，向侧边弯曲身体。"
    },
    {
      "index": 81,
      "label": "0305",
      "text": "用小幅度地、用大幅度地，扭转身体。"
    },
    {
      "index": 82,
      "label": "0306",
      "text": "将向下推动，扩展胸肌。"
    },
    {
      "index": 83,
      "label": "0307",
      "text": "转动，大幅度地转动上半身。"
    },
    {
      "index": 84,
      "label": "0308",
      "text": "按小幅度地、按张开手脚，进行双脚跳。"
    },
    {
      "index": 85,
      "label": "0311",
      "text": "好，今天也精神饱满地做体操吧！"
    },
    {
      "index": 86,
      "label": "0312",
      "text": "好，广播体操现在开始——！"
    },
    {
      "index": 87,
      "label": "0313",
      "text": "好，精神饱满地运动吧！"
